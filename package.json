{
  "name": "paseo-kubernetes",
  "version": "0.1.0-poc.1",
  "private": true,
  "description": "An independent Paseo-compatible host and workspace controller for Kubernetes; not affiliated with or endorsed by Paseo",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:pr-title && npm run test:release && npm run test:qualification && npm run build",
    "dev:doctor": "bash scripts/doctor.sh",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:connect": "bash scripts/connect.sh",
    "test:live": "node --import tsx scripts/live-test.ts",
    "test:private": "node --import tsx scripts/private-live.ts",
    "test:lifecycle": "node --import tsx scripts/lifecycle-live.ts",
    "test:auth": "node --import tsx scripts/auth-live.ts",
    "test:checkout": "node --import tsx scripts/checkout-live.ts",
    "test:cli": "node --import tsx scripts/cli-test.ts",
    "generate:crds": "node --import tsx scripts/generate-crds.ts",
    "credentials": "node --import tsx scripts/credentials.ts",
    "test:upstream": "node --import tsx scripts/upstream-test.ts",
    "test:provider-probe": "node --import tsx scripts/provider-probe-contract.ts",
    "release": "semantic-release",
    "test:release": "node --test tests/release*.mjs",
    "test:pr-title": "node --test scripts/check-pr-title.test.mjs",
    "test:qualification": "node --test tests/eks*.mjs tests/client-acceptance*.mjs tests/local-transport-probe.test.mjs",
    "test:providers": "node --import tsx scripts/provider-live.ts",
    "test:github-app": "node --import tsx scripts/github-app-live.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manziman/paseo-gateway.git"
  },
  "dependencies": {
    "@getpaseo/client": "0.9.1",
    "@getpaseo/protocol": "0.9.1",
    "@kubernetes/client-node": "2.0.0",
    "cron-parser": "5.10.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.5",
    "@types/ws": "8.18.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.8.3"
  }
}
